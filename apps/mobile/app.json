{
  "expo": {
    "name": "Saaliheen",
    "slug": "saaliheen",
    "scheme": "saaliheen",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "com.saaliheen.app", "supportsTablet": true, "usesAppleSignIn": true, "associatedDomains": ["applinks:saaliheen.com"] },
    "android": {
      "package": "com.saaliheen.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "saaliheen.com", "pathPrefix": "/ur/share/" },
            { "scheme": "https", "host": "saaliheen.com", "pathPrefix": "/en/share/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-audio", { "enableBackgroundPlayback": true, "microphonePermission": false, "recordAudioAndroid": false }],
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "extra": {
      "dataOrigin": "https://saaliheen.com",
      "passageHeadings": "off",
      "tafsir": "off"
    }
  }
}
