{
  "name": "@saaliheen/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Saaliheen's mobile app (Expo, React Native): Quran Analysis read from the versioned dataset under /data/v1.",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "export": "expo export --platform ios --platform android",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:served": "vitest run --config vitest.served.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@saaliheen/dataset": "workspace:*",
    "@saaliheen/known-words": "workspace:*",
    "@saaliheen/passages": "workspace:*",
    "@saaliheen/quran-chat": "workspace:*",
    "@saaliheen/reading-places": "workspace:*",
    "@saaliheen/share": "workspace:*",
    "expo": "~57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.0",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.0",
    "@eslint/js": "^9",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.0.2"
  }
}
