{
  "name": "@saaliheen/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "start:standalone": "cp -R .next/static .next/standalone/apps/web/.next/ && node .next/standalone/apps/web/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bddgen && playwright test && NEXT_PUBLIC_PASSAGE_HEADINGS=on NEXT_PUBLIC_TAFSIR=on playwright test && E2E_SKIP_BUILD=1 pnpm test:api && E2E_SKIP_BUILD=1 pnpm test:neon-rows && pnpm test:no-database",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:import": "vitest run --config vitest.import.config.ts",
    "test:neon-rows": "vitest run --config vitest.neon-rows.config.ts",
    "test:no-database": "vitest run --config vitest.no-database.config.ts",
    "test:dev": "vitest run --config vitest.dev.config.ts",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/db-migrate.ts",
    "db:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/db-import.ts",
    "warm-up": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/warm-up.ts",
    "db:seed-allah-references": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/seed-allah-references.ts",
    "db:load-tafsir": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/load-tafsir.ts",
    "db:index-quran-chat": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/index-quran-chat.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@better-auth/expo": "1.7.7",
    "@saaliheen/dataset": "workspace:*",
    "@saaliheen/known-words": "workspace:*",
    "@saaliheen/passages": "workspace:*",
    "@saaliheen/quran-chat": "workspace:*",
    "@saaliheen/reading-places": "workspace:*",
    "@saaliheen/share": "workspace:*",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "next": "16.3.6",
    "pg": "^8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-bdd": "^9.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
