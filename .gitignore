# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are unanchored so they apply in every workspace package (apps/web).

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
# Vitest's run output (written beside coverage)
.vitest/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (seam 2)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# playwright-bdd generated tests (seam 2)
.features-gen/

# Neon CLI context (local org/project ids)
.neon
